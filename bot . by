import os
import logging
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, CommandHandler, MessageHandler, filters
from urllib.parse import urljoin

# إعدادات التسجيل
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# متغير التوكن من البيئة
BOT_TOKEN = os.environ.get('BOT_TOKEN')
if not BOT_TOKEN:
    raise ValueError("يرجى إضافة متغير البيئة BOT_TOKEN")

# رابط الموقع المباشر (سيتم توليده تلقائياً عند النشر على Render)
WEB_APP_URL = os.environ.get('WEB_APP_URL', 'https://your-render-link.onrender.com')

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """أمر البدء مع زر الـ Web App"""
    keyboard = [
        [{"text": "🔞 دخول الموقع 18+", "web_app": {"url": WEB_APP_URL}}]
    ]
    reply_markup = update.effective_message.reply_markup.__class__(keyboard)
    
    await update.message.reply_text(
        "مرحباً بك! 👋\n\n"
        "اضغط الزر أدناه للدخول إلى قسم البالغين:\n"
        "👉 [فتح الموقع](https://t.me/YourBotName?startapp=nsfw)",
        parse_mode="Markdown",
        reply_markup=reply_markup
    )

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("هذا البوت متصل بموقع NSFW الخاص بك.")

def main():
    # تطبيق البوت
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    # الأوامر
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))

    logger.info("البوت يعمل الآن...")
    app.run_polling()

if __name__ == '__main__':
    main()
